---
import type { SiteContent } from "../data/site";

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;

const iconMap = {
  book: "M4 19.5V5.2A2.2 2.2 0 0 1 6.2 3H20v16H6.2A2.2 2.2 0 0 0 4 21.2M12 7h4",
  rocket:
    "M5 19c-1.5 1.2-2 5-2 5s3.8-.5 5-2c.7-.9.7-2.1-.1-2.9A2.2 2.2 0 0 0 5 19Zm10-13c3.7-.7 6-4 6-4s-3.3 2.3-4 6c-.2 1-.8 2-1.6 2.8L12 15l-3-3 4.2-3.4C14 7.8 15 7.2 15 6ZM9 12H4s.6-3 2-4c1.6-1.1 5 0 5 0m1 3v5s3-.6 4-2c1.1-1.6 0-5 0-5",
  chat: "M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z",
  heart:
    "m12 21-1.1-1C5.1 14.7 2 11.9 2 8.5 2 5.4 4.4 3 7.5 3c1.7 0 3.4.8 4.5 2.1C13.1 3.8 14.8 3 16.5 3 19.6 3 22 5.4 22 8.5c0 3.4-3.1 6.2-8.9 11.5Z",
};
---

<section id="vision" class="bg-gradient-to-b from-white to-brand-mist py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <p class="section-kicker">{content.values.kicker}</p>
      <h2 class="section-title">{content.values.title}</h2>
      <p class="section-copy">{content.values.copy}</p>
    </div>

    <div class="mt-14 grid gap-8 md:grid-cols-2 xl:grid-cols-4">
      {content.values.cards.map((card) => (
        <article class="overflow-hidden rounded-[1.75rem] border border-white/60 bg-white shadow-soft">
          <img src={`/images/${card.image}`} alt={card.title} class="h-52 w-full object-cover" />
          <div class="p-6 text-center">
            <svg viewBox="0 0 24 24" fill="none" stroke="url(#section-gradient)" stroke-width="1.8" class="mx-auto mb-4 h-12 w-12">
              <path d={iconMap[card.icon]} stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <h3 class="text-lg font-bold text-slate-900">{card.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">{card.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="bg-gradient-to-b from-brand-mist to-white py-20">
  <div class="mx-auto grid max-w-7xl gap-14 px-4 sm:px-6 lg:grid-cols-[0.95fr_1.05fr] lg:px-8">
    <div class="relative">
      <div class="overflow-hidden rounded-[2rem] shadow-soft">
        <img src={`/images/${content.differentiators.image}`} alt={content.differentiators.imageAlt} class="h-full w-full object-cover" />
      </div>
      <div class="absolute -bottom-8 -right-8 h-32 w-32 rounded-full bg-brand-mint/20 blur-3xl"></div>
    </div>

    <div>
      <p class="section-kicker text-left">{content.differentiators.kicker}</p>
      <h2 class="section-title text-left">{content.differentiators.title}</h2>
      <p class="section-copy max-w-2xl text-left">{content.differentiators.copy}</p>

      <div class="mt-10 grid gap-4 sm:grid-cols-2">
        {content.differentiators.items.map((item) => (
          <div class="rounded-2xl border border-brand-sky/10 bg-white px-5 py-4 shadow-sm">
            <p class="font-semibold text-slate-800">{item}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<section id="life" class="bg-white py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <p class="section-kicker">{content.schoolLife.kicker}</p>
      <h2 class="section-title">{content.schoolLife.title}</h2>
      <p class="section-copy">{content.schoolLife.copy}</p>
    </div>

    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {content.schoolLife.cards.map((card) => (
        <article class="group relative overflow-hidden rounded-[1.6rem] shadow-soft">
          <img src={`/images/${card.image}`} alt={card.title} class="aspect-square w-full object-cover transition duration-500 group-hover:scale-105" />
          <div class="absolute inset-0 bg-gradient-to-t from-brand-lilac/90 via-brand-lilac/35 to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 p-6 text-white">
            <h3 class="text-2xl font-bold">{card.title}</h3>
            <p class="mt-2 text-sm font-medium text-white/90">{card.description}</p>
          </div>
        </article>
      ))}
    </div>

    <p class="mt-12 text-center font-display text-3xl text-brand-lilac">
      {content.schoolLife.quote}
    </p>
  </div>
</section>

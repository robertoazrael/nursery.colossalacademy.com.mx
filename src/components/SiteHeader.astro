---
import type { SiteContent } from "../data/site";

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
---

<header class="sticky top-0 z-50 border-b border-white/40 bg-white/80 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-4 py-4 sm:px-6 lg:px-8">
    <a href="#hero" class="flex items-center gap-3">
      <img
        src="/images/132d57a1c7e924e9346f904c843261456479ccf7.png"
        alt="Colossal Academy Kids"
        class="h-12 w-auto"
      />
    </a>

    <nav class="hidden items-center gap-8 lg:flex">
      {content.navItems.map((item) => (
        <a href={item.href} class="text-sm font-semibold text-slate-700 transition hover:text-brand-lilac">
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <a
        href={content.switcher.alternatePath}
        class="rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-brand-lilac hover:text-brand-lilac"
      >
        {content.switcher.alternate}
      </a>
      <a
        href={content.meta.whatsapp}
        target="_blank"
        rel="noreferrer"
        class="inline-flex items-center rounded-full bg-brand-mint px-5 py-3 text-sm font-semibold text-white shadow-lg transition hover:-translate-y-0.5 hover:bg-emerald-600"
      >
        {content.ctas.bookVisit}
      </a>
    </div>

    <details class="group lg:hidden">
      <summary class="list-none rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm">
        {content.switcher.menu}
      </summary>
      <div class="absolute right-4 top-[72px] w-64 rounded-3xl border border-slate-200 bg-white p-5 shadow-soft">
        <nav class="flex flex-col gap-4">
          {content.navItems.map((item) => (
            <a href={item.href} class="text-sm font-semibold text-slate-700 transition hover:text-brand-lilac">
              {item.label}
            </a>
          ))}
          <a
            href={content.switcher.alternatePath}
            class="rounded-full border border-slate-200 px-4 py-3 text-center text-sm font-semibold text-slate-700"
          >
            {content.switcher.alternate}
          </a>
          <a
            href={content.meta.whatsapp}
            target="_blank"
            rel="noreferrer"
            class="mt-2 rounded-full bg-brand-mint px-4 py-3 text-center text-sm font-semibold text-white"
          >
            {content.ctas.bookVisit}
          </a>
        </nav>
      </div>
    </details>
  </div>
</header>

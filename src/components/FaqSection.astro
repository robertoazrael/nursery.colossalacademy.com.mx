---
import type { SiteContent } from "../data/site";

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
---

<section class="bg-gradient-to-b from-white to-brand-mist py-20">
  <div class="mx-auto grid max-w-7xl items-center gap-14 px-4 sm:px-6 lg:grid-cols-[0.92fr_1.08fr] lg:px-8">
    <div class="overflow-hidden rounded-[2rem] shadow-soft">
      <img src={`/images/${content.faq.image}`} alt={content.faq.imageAlt} class="h-full w-full object-cover" />
    </div>

    <div>
      <p class="section-kicker text-left">{content.faq.kicker}</p>
      <h2 class="section-title text-left">{content.faq.title}</h2>
      <p class="section-copy max-w-2xl text-left">{content.faq.copy}</p>

      <div class="mt-10 space-y-4">
        {content.faq.items.map((item) => (
          <details class="group rounded-[1.4rem] border border-brand-sky/10 bg-white p-1 shadow-sm">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-[1.1rem] px-5 py-4 font-semibold text-brand-mint">
              <span>{item.question}</span>
              <span class="text-2xl transition group-open:rotate-45">+</span>
            </summary>
            <div class="px-5 pb-5 pt-1 text-sm leading-7 text-slate-600">
              {item.answer}
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

---
import { sharedSiteMeta, type SiteContent } from "../data/site";

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
---

<section class="relative overflow-hidden bg-gradient-to-br from-brand-lilac via-brand-sky to-brand-mint py-20 text-white">
  <div class="absolute -left-16 -top-16 h-52 w-52 rounded-full bg-white/10 blur-3xl"></div>
  <div class="absolute -bottom-24 -right-16 h-72 w-72 rounded-full bg-white/10 blur-3xl"></div>
  <div class="relative mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
    <h2 class="text-4xl font-extrabold leading-tight">{content.contact.ctaTitle}</h2>
    <p class="mx-auto mt-6 max-w-2xl text-xl leading-8 text-white/90">
      {content.contact.ctaCopy}
    </p>
    <a
      href={content.meta.whatsapp}
      target="_blank"
      rel="noreferrer"
      class="mt-10 inline-flex rounded-full bg-white px-8 py-4 text-lg font-bold text-brand-lilac shadow-soft transition hover:-translate-y-1"
    >
      {content.ctas.visitUs}
    </a>
  </div>
</section>

<section id="contacto" class="bg-white py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <p class="section-kicker">{content.contact.kicker}</p>
      <h2 class="section-title">{content.contact.title}</h2>
      <p class="section-copy">{content.contact.copy}</p>
    </div>

    <div class="mt-14 grid gap-10 lg:grid-cols-[0.7fr_1.3fr]">
      <div class="rounded-[2rem] bg-brand-mist p-8 shadow-sm">
        <h3 class="text-xl font-bold text-brand-lilac">{content.contact.infoTitle}</h3>
        <div class="mt-6 space-y-6">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-sky">{content.contact.labels.address}</p>
            <p class="mt-2 leading-7 text-slate-700">{sharedSiteMeta.address}</p>
          </div>
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-sky">{content.contact.labels.phone}</p>
            <a href={`tel:${sharedSiteMeta.phone}`} class="mt-2 block leading-7 text-slate-700 hover:text-brand-lilac">
              {sharedSiteMeta.phoneDisplay}
            </a>
          </div>
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-sky">{content.contact.labels.email}</p>
            <a href={`mailto:${sharedSiteMeta.email}`} class="mt-2 block leading-7 text-slate-700 hover:text-brand-lilac">
              {sharedSiteMeta.email}
            </a>
          </div>
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-sky">{content.contact.labels.hours}</p>
            <p class="mt-2 leading-7 text-slate-700">{content.contact.hours}</p>
          </div>
        </div>
      </div>

      <div class="overflow-hidden rounded-[2rem] shadow-soft">
        <iframe
          src={sharedSiteMeta.mapEmbed}
          title={content.contact.mapTitle}
          class="h-[520px] w-full border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </div>
</section>

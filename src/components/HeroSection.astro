---
import { sharedSiteMeta, type SiteContent } from "../data/site";

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
---

<section id="hero" class="relative overflow-hidden bg-gradient-to-br from-brand-cream via-white to-brand-sand">
  <div class="absolute inset-0 opacity-30">
    <div class="hero-grid h-full w-full"></div>
  </div>

  <div class="pointer-events-none absolute inset-0 hidden md:block">
    {content.hero.decorations.map((item) => (
      <img
        src={`/images/${item.src}`}
        alt={item.alt}
        class:list={["absolute animate-float", item.className]}
        style={`animation-delay:${item.delay};`}
      />
    ))}
  </div>

  <div class="relative mx-auto grid min-h-[calc(100vh-88px)] max-w-7xl items-center gap-14 px-4 py-16 sm:px-6 lg:grid-cols-[1.05fr_0.95fr] lg:px-8 lg:py-20">
    <div class="animate-rise">
      <p class="mb-4 inline-flex rounded-full border border-brand-sky/20 bg-white/80 px-4 py-2 text-sm font-semibold text-brand-sky shadow-sm">
        {content.hero.eyebrow}
      </p>
      <h1 class="max-w-3xl text-5xl font-extrabold leading-tight text-slate-900 md:text-6xl xl:text-7xl">
        {content.hero.title}
        <span class="inline-block align-middle">
          <img src="/images/db48f16efa5ca70c9f1cc897b3fa1a7f3a2dec84.png" alt={content.hero.worldAlt} class="ml-3 inline-block w-14 animate-float" />
        </span>
      </h1>
      <p class="mt-6 max-w-2xl text-xl leading-relaxed text-slate-700 md:text-2xl">
        {content.hero.description}
      </p>

      <div class="mt-10 flex flex-col gap-4 sm:flex-row">
        <a
          href="#vision"
          class="inline-flex items-center justify-center rounded-full bg-gradient-to-r from-brand-mint to-brand-sky px-7 py-4 text-base font-semibold text-white shadow-soft transition hover:-translate-y-1"
        >
          {content.ctas.explore}
        </a>
        <a
          href={content.meta.whatsapp}
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center justify-center rounded-full border border-brand-lilac/20 bg-white px-7 py-4 text-base font-semibold text-brand-lilac transition hover:border-brand-lilac hover:bg-brand-mist"
        >
          {content.ctas.whatsapp}
        </a>
      </div>
    </div>

    <div class="animate-rise [animation-delay:160ms]">
      <div class="relative overflow-hidden rounded-[2rem] border border-white/60 bg-white p-3 shadow-soft">
        <div class="absolute inset-x-0 top-0 h-28 bg-gradient-to-b from-brand-lilac/15 to-transparent"></div>
        <div class="relative aspect-video overflow-hidden rounded-[1.4rem] bg-slate-900">
          <iframe
            class="h-full w-full"
            src={`https://www.youtube.com/embed/${sharedSiteMeta.youtubeVideoId}?rel=0`}
            title={content.hero.videoTitle}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </div>
  </div>
</section>

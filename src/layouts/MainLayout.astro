---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  lang: "es" | "en";
  path: string;
}

const { title, description, lang, path } = Astro.props;
const baseUrl = "https://nursery.colossalacademy.com.mx";
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#6d67c8" />
    <link rel="canonical" href={`${baseUrl}${path}`} />
    <link rel="alternate" hreflang="es" href={baseUrl} />
    <link rel="alternate" hreflang="en" href={`${baseUrl}/en`} />
    <link rel="alternate" hreflang="x-default" href={baseUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
  </head>
  <body class="bg-brand-cream font-sans text-slate-800 antialiased">
    <slot />
  </body>
</html>
